# .gitignore

# outputs (regenerable; the parquet tables are ~500 MB)
out/
*.parquet
*.npz
*.npy
*.csv
figures/
*.png
*.pdf

# python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/

# tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# editor / os
.vscode/
.idea/
.DS_Store
*.swp

# latex build products (paper lives alongside)
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
*.toc

# computed Moliere f1/f2 cache (regenerated at import)
_fn_projected.npz

# local reduced-statistics repro harness
_repro.py


# =========================
# Build directories
# =========================
build/
cmake-build-*/
_build/
out/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
CTestTestfile.cmake
compile_commands.json

# =========================
